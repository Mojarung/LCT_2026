<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="green_editing_definitions" targetNamespace="https://github.com/Mojarung/LCT_2026">
  <process id="green_after_run" name="После прогона: правка плана и визуализация" isExecutable="false">
    <startEvent id="start" name="Готовый прогон: DXF, план, контекст правки" />
    <exclusiveGateway id="g_after" name="Что дальше?" />
    <task id="t_edit" name="Правка на карте: перенос, удаление, проверка точки теми же нормами" />
    <task id="t_recheck" name="Независимая проверка исправленного плана" />
    <task id="t_rewrite" name="Запись GREEN_* в копию исходника, сверка исходника и DXF" />
    <exclusiveGateway id="g_ok" name="Проверки пройдены?" />
    <endEvent id="e_saved" name="Исправленный DXF и интерпретации" />
    <endEvent id="e_kept" name="Экспорт отклонён, прежний DXF сохранён" />
    <task id="t_scene" name="3D-сцена из scene.json: здания, покрытия, посадки по видам" />
    <task id="t_shots" name="Снимки участка в PNG: сезон, возраст посадок, погода" />
    <endEvent id="e_scene" name="Визуализации, согласованные с планом" />
    <sequenceFlow id="e1" sourceRef="start" targetRef="g_after" />
    <sequenceFlow id="e2" name="правка" sourceRef="g_after" targetRef="t_edit" />
    <sequenceFlow id="e3" sourceRef="t_edit" targetRef="t_recheck" />
    <sequenceFlow id="e4" sourceRef="t_recheck" targetRef="t_rewrite" />
    <sequenceFlow id="e5" sourceRef="t_rewrite" targetRef="g_ok" />
    <sequenceFlow id="e6" name="да" sourceRef="g_ok" targetRef="e_saved" />
    <sequenceFlow id="e7" name="нет" sourceRef="g_ok" targetRef="e_kept" />
    <sequenceFlow id="e8" name="визуализация" sourceRef="g_after" targetRef="t_scene" />
    <sequenceFlow id="e9" sourceRef="t_scene" targetRef="t_shots" />
    <sequenceFlow id="e10" sourceRef="t_shots" targetRef="e_scene" />
  </process>
  <bpmndi:BPMNDiagram id="editing_diagram">
    <bpmndi:BPMNPlane id="editing_plane" bpmnElement="green_after_run">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="182" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
