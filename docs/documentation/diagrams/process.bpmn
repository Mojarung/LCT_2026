<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="green_definitions" targetNamespace="https://github.com/Mojarung/LCT_2026">
  <process id="green_run" name="Прогон green: DXF -&gt; план посадок -&gt; DXF" isExecutable="false">
    <startEvent id="start" name="Чертёж DXF или DWG, комплект, слои ГИС, профиль" />
    <exclusiveGateway id="g_dwg" name="DWG?" />
    <task id="t_convert" name="Конвертация DWG в DXF (ODA или LibreDWG)" />
    <exclusiveGateway id="g_dwg_join" />
    <task id="t_assemble" name="Сборка комплекта: внешние ссылки, склейка, единицы" />
    <task id="t_read" name="Чтение без потерь: единицы, учёт каждого примитива, геометрия, подписи" />
    <exclusiveGateway id="g_read" name="Единицы ясны, геометрия прочитана полностью?" />
    <endEvent id="e_read" name="Остановка: отчёт о единицах или потерях чтения" />
    <task id="t_classify" name="Классификация: знаки, слои, блоки, словарь имён" />
    <exclusiveGateway id="g_classify" name="Классы определены?" />
    <endEvent id="e_classify" name="Остановка: карта уточнения классов" />
    <task id="t_gis" name="Слои ГИС: координаты в МСК, классы, совмещение по зданиям" />
    <task id="t_surface" name="Карта покрытий: грунт и твёрдое по замкнутым граням" />
    <task id="t_index" name="Индекс ограничений: нормы как данные (config/rules.yaml)" />
    <task id="t_candidates" name="Кандидаты: аллея вдоль борта, сетка по газону, добор зоны" />
    <task id="t_select" name="Отбор мест: жадный или MILP, шаг и посадочные места" />
    <task id="t_species" name="Подбор вида: фильтры норм, оценка пригодности, MILP квот" />
    <task id="t_shrubs" name="Кустарник: ряд у борта, изгородь, подлесок, группы на газоне" />
    <task id="t_validate" name="Независимая проверка варианта (validate_plan)" />
    <exclusiveGateway id="g_portfolio" name="Варианты или бюджет исчерпаны?" />
    <task id="t_choose" name="Выбор прошедшего проверку плана по индексу качества (нет такого - остановка)" />
    <task id="t_refine" name="Сдвиг посадок от сетей с повторной проверкой" />
    <task id="t_lawns" name="Газоны на свободном грунте" />
    <task id="t_explain" name="Объяснения из трассы правил: акт, пункт, цитата" />
    <task id="t_write" name="Запись слоёв GREEN_* в копию исходника" />
    <task id="t_verify" name="Сверка исходных сущностей и соответствия DXF плану" />
    <exclusiveGateway id="g_verify" name="Обе проверки пройдены?" />
    <endEvent id="e_verify" name="Экспорт отклонён, прежний результат сохранён" />
    <task id="t_artifacts" name="Артефакты: result.dxf, интерпретации JSON, CSV, MD, HTML" />
    <endEvent id="e_done" name="DXF с результатом и интерпретации" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="g_dwg" />
    <sequenceFlow id="f2" name="да" sourceRef="g_dwg" targetRef="t_convert" />
    <sequenceFlow id="f3" name="нет" sourceRef="g_dwg" targetRef="g_dwg_join" />
    <sequenceFlow id="f4" sourceRef="t_convert" targetRef="g_dwg_join" />
    <sequenceFlow id="f5" sourceRef="g_dwg_join" targetRef="t_assemble" />
    <sequenceFlow id="f6" sourceRef="t_assemble" targetRef="t_read" />
    <sequenceFlow id="f7" sourceRef="t_read" targetRef="g_read" />
    <sequenceFlow id="f8" name="нет" sourceRef="g_read" targetRef="e_read" />
    <sequenceFlow id="f9" name="да" sourceRef="g_read" targetRef="t_classify" />
    <sequenceFlow id="f10" sourceRef="t_classify" targetRef="g_classify" />
    <sequenceFlow id="f11" name="нет" sourceRef="g_classify" targetRef="e_classify" />
    <sequenceFlow id="f12" name="да" sourceRef="g_classify" targetRef="t_gis" />
    <sequenceFlow id="f13" sourceRef="t_gis" targetRef="t_surface" />
    <sequenceFlow id="f14" sourceRef="t_surface" targetRef="t_index" />
    <sequenceFlow id="f15" sourceRef="t_index" targetRef="t_candidates" />
    <sequenceFlow id="f16" sourceRef="t_candidates" targetRef="t_select" />
    <sequenceFlow id="f17" sourceRef="t_select" targetRef="t_species" />
    <sequenceFlow id="f18" sourceRef="t_species" targetRef="t_shrubs" />
    <sequenceFlow id="f19" sourceRef="t_shrubs" targetRef="t_validate" />
    <sequenceFlow id="f20" sourceRef="t_validate" targetRef="g_portfolio" />
    <sequenceFlow id="f21" name="нет: следующий вариант" sourceRef="g_portfolio" targetRef="t_candidates" />
    <sequenceFlow id="f22" name="да" sourceRef="g_portfolio" targetRef="t_choose" />
    <sequenceFlow id="f23" sourceRef="t_choose" targetRef="t_refine" />
    <sequenceFlow id="f24" sourceRef="t_refine" targetRef="t_lawns" />
    <sequenceFlow id="f25" sourceRef="t_lawns" targetRef="t_explain" />
    <sequenceFlow id="f26" sourceRef="t_explain" targetRef="t_write" />
    <sequenceFlow id="f27" sourceRef="t_write" targetRef="t_verify" />
    <sequenceFlow id="f28" sourceRef="t_verify" targetRef="g_verify" />
    <sequenceFlow id="f29" name="нет" sourceRef="g_verify" targetRef="e_verify" />
    <sequenceFlow id="f30" name="да" sourceRef="g_verify" targetRef="t_artifacts" />
    <sequenceFlow id="f31" sourceRef="t_artifacts" targetRef="e_done" />
  </process>
