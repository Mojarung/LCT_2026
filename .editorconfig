root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,toml}]
indent_size = 2

# Фронтенд: отступ 2, как у Prettier в frontend/.prettierrc.json.
[frontend/**.{ts,tsx,js,mjs,css,html}]
indent_size = 2
